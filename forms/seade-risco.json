  {
   "nome": "Matriz de Probabilidade",
   "rotulo": "Matriz de Probabilidade",
   "tipo": "text",
   "expr": "CASE\r\nWHEN  \"Falha+Impacto\"  = '1+1' THEN 'Improvavel'\r\nWHEN  \"Falha+Impacto\"  = '1+2' THEN 'Pouco provavel'\r\nWHEN  \"Falha+Impacto\"  = '1+3' THEN 'Provavel'\r\nWHEN  \"Falha+Impacto\"  = '1+4' THEN 'Muito provavel'\r\nWHEN  \"Falha+Impacto\"  = '2+1' THEN 'Improvavel'\r\nWHEN  \"Falha+Impacto\"  = '2+2' THEN 'Improvavel'\r\nWHEN  \"Falha+Impacto\"  = '2+3' THEN 'Pouco provavel'\r\nWHEN  \"Falha+Impacto\"  = '2+4' THEN 'Provavel'\r\nWHEN  \"Falha+Impacto\"  = '3+1' THEN 'Improvavel'\r\nWHEN  \"Falha+Impacto\"  = '3+2' THEN 'Improvavel'\r\nWHEN  \"Falha+Impacto\"  = '3+3' THEN 'Improvavel'\r\nWHEN  \"Falha+Impacto\"  = '3+4' THEN 'Pouco provavel'\r\nWHEN  \"Falha+Impacto\"  = '4+1' THEN 'Improvavel'\r\nWHEN  \"Falha+Impacto\"  = '4+2' THEN 'Improvavel'\r\nWHEN  \"Falha+Impacto\"  = '4+3' THEN 'Improvavel'\r\nWHEN  \"Falha+Impacto\"  = '4+4' THEN 'Improvavel'\r\nEND",
   "calculado": true,
   "armazenar": "text"
  },
